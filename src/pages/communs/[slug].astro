---
import { getCollection, render } from 'astro:content';
import RessourceLayout from '../../layouts/RessourceLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('ressources', (entry) => entry.id.startsWith('fr/'));
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/^fr\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<RessourceLayout lang="fr" entry={entry} headings={headings}>
  <Content />
</RessourceLayout>
