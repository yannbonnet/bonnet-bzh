---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Étude de branche importée depuis _import/branche-bonnet-carquefou.html
// (fonds MyHeritage « Bonnet — Muloise — Rattier »), reliée depuis la
// section XI de /genealogie/. Document autonome, mise en page A4
// « web-to-print » volontaire : CSS interne non touché, seul l'habillage
// du site (BaseLayout : nav, pied de page, meta) a été ajouté.
const DESCRIPTION = "Étude généalogique de la branche Bonnet de Carquefou (Loire-Atlantique) : 58 ancêtres directs sur onze générations, de 1620 à 1950 — un bienheureux massacré aux Carmes, un carabinier mort à Strasbourg, un poilu tué à Quennevières, une religieuse partie pour Séoul.";
---

<BaseLayout lang="fr" title="La branche Bonnet de Carquefou" description={DESCRIPTION}>
<style>
/* ============================================================
   LA BRANCHE BONNET DE CARQUEFOU
   Feuille de style « édition critique » — web-to-print A4
   Parti pris : l'appareil d'archive (cotes, vues, numéros Sosa)
   vit dans la marge, en monospace, comme les annotations d'un
   greffier. Le récit occupe la colonne de texte.
   ============================================================ */

:root{
  --ink:      #1B1F24;   /* encre de registre */
  --paper:    #EDEEE9;   /* papier lichen, froid */
  --lichen:   #47664F;   /* accent : ardoise mousse de Bretagne */
  --register: #8A2D28;   /* rouge de mention marginale — deuils et guerres */
  --sage:     #737E73;   /* appareil critique */
  --rule:     #C6C9C0;
  --paper-2:  #E3E5DE;   /* encarts */
}

*{box-sizing:border-box}

html{ -webkit-text-size-adjust:100%; }

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"Newsreader",Georgia,serif;
  font-optical-sizing:auto;
  font-weight:400;
  font-size:10.5pt;
  line-height:1.58;
  hyphens:auto;
}

/* ---------- grille : marge d'appareil + colonne de texte ---------- */
.sheet{ max-width:186mm; margin:0 auto; padding:14mm 10mm 20mm; }

.spread{
  display:grid;
  grid-template-columns:32mm 1fr;
  column-gap:9mm;
  align-items:start;
}
.spread > .col{ grid-column:2; min-width:0; }
.marg{
  grid-column:1;
  font-family:"IBM Plex Mono",ui-monospace,monospace;
  font-size:6.6pt;
  line-height:1.5;
  color:var(--sage);
  letter-spacing:.005em;
  text-align:right;
  padding-top:.35em;
  hyphens:none;
}
.marg b{ color:var(--lichen); font-weight:500; display:block; letter-spacing:.06em; text-transform:uppercase; }
.marg .cote{ display:block; margin-top:.5em; }

/* ---------- typographie ---------- */
h1,h2,h3,h4{ font-weight:400; margin:0; }

.eyebrow{
  font-family:"IBM Plex Mono",monospace;
  font-size:6.8pt; letter-spacing:.22em; text-transform:uppercase;
  color:var(--lichen); margin:0 0 .9em;
}

h2{
  font-size:19pt; line-height:1.14; letter-spacing:-.012em;
  margin:0 0 .15em; font-weight:400;
}
h2 em{ font-style:italic; }
h3{
  font-size:12.5pt; font-style:italic; font-weight:400;
  margin:1.9em 0 .35em; letter-spacing:-.004em;
}
h4{
  font-family:"IBM Plex Mono",monospace;
  font-size:7pt; letter-spacing:.16em; text-transform:uppercase;
  color:var(--lichen); margin:1.6em 0 .5em;
}
p{ margin:0 0 .72em; text-align:justify; text-justify:inter-word; }
p.lede{
  font-size:12pt; line-height:1.5; color:#2A3038;
  text-align:left; margin-bottom:1.1em;
}
p + p{ text-indent:1.15em; }
p.lede + p, h3 + p, h4 + p, blockquote + p, figure + p, .box + p, table + p{ text-indent:0; }
a{ color:var(--lichen); text-decoration:none; border-bottom:.4pt solid var(--rule); }
small{ font-size:8pt; }

.rule{ border:0; border-top:.5pt solid var(--rule); margin:1.7em 0; }
.rule--thick{ border-top:1.6pt solid var(--ink); margin:2.2em 0 1.4em; }

/* ---------- couverture ---------- */
.cover{ padding:26mm 0 0; border-bottom:1.6pt solid var(--ink); margin-bottom:2.4em; }
.cover .kicker{
  font-family:"IBM Plex Mono",monospace; font-size:7pt;
  letter-spacing:.26em; text-transform:uppercase; color:var(--lichen);
}
.cover h1{
  font-size:40pt; line-height:1.0; letter-spacing:-.028em;
  margin:.5em 0 .3em; font-weight:300;
}
.cover h1 em{ font-style:italic; font-weight:400; }
.cover .sub{
  font-size:13pt; font-style:italic; color:#39404A;
  max-width:36em; line-height:1.42; margin:0 0 1.6em;
}
.cover .meta{
  display:flex; flex-wrap:wrap; gap:0 2.4em;
  font-family:"IBM Plex Mono",monospace; font-size:6.9pt;
  letter-spacing:.05em; color:var(--sage); padding-bottom:1.6em;
}
.cover .meta div span{ display:block; color:var(--ink); }

/* ---------- chiffres-clés ---------- */
.stats{
  display:grid; grid-template-columns:repeat(4,1fr);
  gap:0; border-top:.5pt solid var(--rule); border-bottom:.5pt solid var(--rule);
  margin:1.6em 0 2em;
}
.stats div{ padding:.85em .9em .85em 0; border-right:.5pt solid var(--rule); }
.stats div:last-child{ border-right:0; }
.stats .n{
  display:block; font-size:21pt; line-height:1; letter-spacing:-.03em; font-weight:300;
}
.stats .l{
  display:block; font-family:"IBM Plex Mono",monospace; font-size:6.3pt;
  letter-spacing:.1em; text-transform:uppercase; color:var(--sage); margin-top:.5em;
}

/* ---------- fiche biographique ---------- */
.fiche{ margin:2.2em 0 0; break-inside:avoid; }
.fiche > .hdr{
  border-top:1.2pt solid var(--ink); padding-top:.6em; margin-bottom:.7em;
}
.fiche .sosa{
  font-family:"IBM Plex Mono",monospace; font-size:6.6pt;
  letter-spacing:.14em; text-transform:uppercase; color:var(--lichen);
  display:flex; justify-content:space-between; gap:1em; margin-bottom:.35em;
}
.fiche h3{ margin:0 0 .1em; font-style:normal; font-size:15pt; letter-spacing:-.012em; }
.fiche h3 em{ font-style:italic; }
.fiche .dates{
  font-family:"IBM Plex Mono",monospace; font-size:7pt; color:var(--sage);
  letter-spacing:.03em;
}
.fiche--deuil > .hdr{ border-top-color:var(--register); }
.fiche--deuil .sosa{ color:var(--register); }

/* ---------- encarts ---------- */
.box{
  background:var(--paper-2); padding:1.05em 1.15em .85em;
  margin:1.4em 0; break-inside:avoid;
  border-left:2pt solid var(--lichen);
}
.box h4{ margin-top:0; }
.box p{ font-size:9.4pt; line-height:1.5; margin-bottom:.5em; }
.box p:last-child{ margin-bottom:0; }
.box--alert{ border-left-color:var(--register); }
.box--alert h4{ color:var(--register); }

blockquote{
  margin:1.3em 0 1.3em 0; padding:0 0 0 1.1em;
  border-left:.5pt solid var(--rule);
  font-style:italic; font-size:10pt; color:#333A42;
}
blockquote cite{
  display:block; font-style:normal; font-family:"IBM Plex Mono",monospace;
  font-size:6.6pt; letter-spacing:.09em; text-transform:uppercase;
  color:var(--sage); margin-top:.55em;
}

/* ---------- tableaux ---------- */
table{
  width:100%; border-collapse:collapse; margin:1.1em 0 1.4em;
  font-size:8.6pt; break-inside:avoid;
}
caption{
  text-align:left; font-family:"IBM Plex Mono",monospace; font-size:6.6pt;
  letter-spacing:.14em; text-transform:uppercase; color:var(--lichen);
  padding-bottom:.6em;
}
th{
  text-align:left; font-weight:500; font-size:6.6pt;
  font-family:"IBM Plex Mono",monospace; letter-spacing:.09em; text-transform:uppercase;
  color:var(--sage); border-bottom:.9pt solid var(--ink);
  padding:0 .7em .45em 0; vertical-align:bottom;
}
td{ padding:.5em .7em .5em 0; border-bottom:.4pt solid var(--rule); vertical-align:top; }
td.num{ font-family:"IBM Plex Mono",monospace; font-size:8pt; white-space:nowrap; }
tr.flag td{ color:var(--register); }
tr.flag td.num{ font-weight:500; }

/* ---------- figures ---------- */
figure{ margin:1.5em 0; break-inside:avoid; }
figure img{
  width:100%; height:auto; display:block;
  filter:saturate(.82) contrast(1.03);
  background:var(--paper-2);
}
figcaption{
  font-family:"IBM Plex Mono",monospace; font-size:6.4pt; line-height:1.55;
  color:var(--sage); margin-top:.55em; letter-spacing:.01em; hyphens:none;
}
figcaption b{ color:var(--ink); font-weight:500; }
figcaption a{ border-bottom:none; color:var(--sage); }
.figrow{ display:grid; grid-template-columns:1fr 1fr; gap:1.1em; margin:1.5em 0; }
.figrow figure{ margin:0; }

/* cartouche : illustration à sourcer par l'auteur */
.cartouche{
  border:.5pt dashed var(--sage); padding:.9em 1em;
  margin:1.4em 0; break-inside:avoid;
  font-family:"IBM Plex Mono",monospace; font-size:6.8pt; line-height:1.6;
  color:var(--sage); hyphens:none;
}
.cartouche b{
  display:block; color:var(--lichen); letter-spacing:.14em;
  text-transform:uppercase; font-weight:500; margin-bottom:.4em; font-size:6.4pt;
}
.cartouche a{ color:var(--ink); border-bottom:.4pt solid var(--rule); }

/* ---------- schéma SVG ---------- */
.schema{ margin:1.8em 0; break-inside:avoid; }
.schema svg{ width:100%; height:auto; display:block; }

/* ---------- listes ---------- */
ul,ol{ margin:.4em 0 1em; padding-left:1.15em; }
li{ margin-bottom:.34em; }
ul.tight{ list-style:none; padding-left:0; }
ul.tight li{
  padding-left:1.1em; position:relative; margin-bottom:.5em;
}
ul.tight li::before{
  content:"—"; position:absolute; left:0; color:var(--lichen);
}

/* ---------- pied ---------- */
.colophon{
  border-top:1.6pt solid var(--ink); margin-top:2.6em; padding-top:1em;
  font-family:"IBM Plex Mono",monospace; font-size:6.6pt; line-height:1.7;
  color:var(--sage); letter-spacing:.02em; hyphens:none;
}

/* ============================================================
   IMPRESSION
   ============================================================ */
@page{
  size:A4;
  margin:17mm 15mm 19mm 15mm;
  @bottom-center{ content:counter(page); }
}
@page:first{ margin-top:24mm; }

@media print{
  body{ background:#fff; font-size:9.6pt; }
  .sheet{ max-width:none; margin:0; padding:0; }
  .no-print{ display:none !important; }
  h2,h3,.fiche{ break-after:avoid; }
  h2{ break-before:page; }
  .cover h2, .cover + * h2:first-child{ break-before:auto; }
  #ouverture h2{ break-before:avoid; }
  figure,table,.box,.schema,.cartouche,blockquote,.stats{ break-inside:avoid; }
  p{ orphans:3; widows:3; }
  a{ border-bottom:none; color:var(--ink); }
  .marg{ font-size:6pt; }
  figure img{ max-height:88mm; object-fit:contain; object-position:left top; }
}

@media (max-width:760px){
  .spread{ grid-template-columns:1fr; }
  .spread > .col{ grid-column:1; }
  .marg{
    grid-column:1; text-align:left; border-left:2pt solid var(--rule);
    padding:.4em 0 .4em .8em; margin-bottom:1em;
  }
  .marg b{ display:inline; margin-right:.6em; }
  .marg .cote{ display:inline; }
  .cover h1{ font-size:27pt; }
  .stats{ grid-template-columns:1fr 1fr; }
  .stats div:nth-child(2){ border-right:0; }
  .figrow{ grid-template-columns:1fr; }
}

@media (prefers-reduced-motion:reduce){ *{ animation:none !important; transition:none !important; } }

.aide{
  background:var(--ink); color:var(--paper); padding:1em 1.2em;
  font-family:"IBM Plex Mono",monospace; font-size:7.4pt; line-height:1.7;
  margin-bottom:2em; letter-spacing:.02em;
}
.aide b{ color:#A8C4AE; }
</style>
<div class="sheet">

<!-- ═══════════════════════ COUVERTURE ═══════════════════════ -->
<header class="cover">
  <p class="kicker">Étude de branche · Fonds MyHeritage « Bonnet — Muloise — Rattier » · version corrigée du 15 août 2026</p>
  <h1>Neuf générations<br>sur la même <em>colline</em></h1>
  <p class="sub">La branche Bonnet de Carquefou, de 1620 à nos jours : laboureurs, métayers, journaliers — et cinq destins qui ont rompu la ligne.</p>
  <div class="meta">
    <div>Tête de branche<span>Loïc Bonnet, né en 1950</span></div>
    <div>Profondeur<span>11 générations · 1620-1950</span></div>
    <div>Ancêtres identifiés<span>58 sur 2 047 théoriques</span></div>
    <div>Épicentre<span>Carquefou, Loire-Atlantique</span></div>
  </div>
</header>

<!-- ═══════════════════════ OUVERTURE ═══════════════════════ -->
<section id="ouverture" class="spread">
  <aside class="marg">
    <b>Périmètre</b>
    58 ascendants directs de Loïc Bonnet, plus leurs 106 frères et sœurs recensés : 164 individus au total, extraits d'un fonds de 2 169 fiches.
    <span class="cote">version_corrigee_v3.ged<br>GEDCOM 5.5.1 · UTF-8<br>2 169 INDI · 668 FAM<br>187 sources citées<br><br>Trois passes de<br>correction appliquées<br>depuis l'export<br>du 1<sup>er</sup> août :<br>datation, toponymie,<br>champs de métier,<br>balises de décès,<br>boucle de filiation.<br>Journal complet en<br>fin de volume.</span>
  </aside>
  <div class="col">
    <p class="eyebrow">Ce que dit le fichier</p>
    <h2>Une famille qui n'a pas bougé — <em>sauf quand l'Histoire est venue la chercher</em></h2>

    <p class="lede">Sur onze générations, la branche Bonnet tient dans un rayon de six kilomètres. Carquefou revient 176 fois dans les actes ; Nantes, la grande ville voisine, 31 fois seulement. Tous les autres lieux réunis — Sainte-Luce, Le Cellier, Indre, Nort-sur-Erdre — ne pèsent qu'une poignée de mentions. Le métier ne bouge pas davantage : sur les cinquante-huit ancêtres, on compte vingt-deux <em>laboureurs</em>, neuf <em>cultivateurs</em>, huit <em>cultivatrices</em>, deux métayers, deux journaliers, deux domestiques. Pas un marchand, pas un artisan, pas un notaire.</p>

    <p>C'est précisément ce qui rend les exceptions lisibles. Quand un fils de laboureur de Carquefou meurt à Paris, à Strasbourg ou dans l'Oise, ce n'est jamais parce qu'il a choisi de partir : c'est que la Révolution, la conscription impériale ou la Grande Guerre est passée par la métairie. Cinq trajectoires rompent la ligne — un prêtre massacré aux Carmes, un séminariste disparu sous la Terreur, un carabinier mort à dix-neuf ans, un poilu tué au premier jour d'une offensive, une religieuse envoyée à Séoul. À elles cinq, elles racontent l'histoire de France mieux qu'un manuel.</p>

    <div class="stats">
      <div><span class="n">176</span><span class="l">mentions de Carquefou</span></div>
      <div><span class="n">22 %</span><span class="l">morts avant 5 ans</span></div>
      <div><span class="n">1620</span><span class="l">ancêtre le plus ancien</span></div>
      <div><span class="n">8</span><span class="l">unions sous consentement</span></div>
    </div>
  </div>
</section>

<!-- ═══════════════════════ LE PAYS ═══════════════════════ -->
<section class="spread">
  <aside class="marg">
    <b>Toponymes</b>
    Les hameaux nommés dans les actes : la Filonnière (13 mentions), la Gouachère (7), la Savaudière, le Housseau, la Bréchetière, la Magdeleine, la Pintinière, la Monnerie, la Salle, l'Angle, Riou, Tournière, le Plessis-Chéreau.
    <span class="cote">Norme retenue : toponyme historique, jamais le nom de commune fusionnée.</span>
  </aside>
  <div class="col">
    <p class="eyebrow">Le pays</p>
    <h2>Carquefou, une paroisse de métairies</h2>

    <p class="lede">Le bourg est perché sur l'un des points hauts de la commune, à 34 mètres, et son église se voit à plusieurs kilomètres à la ronde. Tout autour, une constellation de métairies et de villages — c'est là, et non au bourg, que la famille vit et meurt.</p>

    <p>Les actes ne disent presque jamais « Carquefou » tout court : ils disent « Carquefou la Filonnière », « Carquefou la Bréchetière », « Carquefou la Magdeleine ». Ces noms de lieux-dits sont l'unité de vie réelle. La Filonnière, en particulier, revient sur quatre générations : c'est là que naissent Jean Bourgouin en 1792, Jeanne Briand en 1795, plusieurs enfants Bourgouin dans les années 1830, puis Louis Frédéric Bonnet en 1884 et son frère Henri en 1885. Ce n'est pas un hasard mais une exploitation transmise.</p>

    <figure>
      <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Carquefou%20%C3%A9glise.jpg?width=1100" alt="L'église Saint-Pierre-et-Saint-Paul de Carquefou">
      <figcaption><b>L'église Saint-Pierre-et-Saint-Paul de Carquefou.</b> Point culminant de la commune, et lieu de la quasi-totalité des baptêmes, mariages et sépultures de la branche entre 1620 et 1900. Les actes la désignent « Carquefou—Saint-Pierre ». — Wikimedia Commons, <i>Carquefou église.jpg</i> · commons.wikimedia.org/wiki/File:Carquefou_église.jpg</figcaption>
    </figure>

    <div class="figrow">
      <figure>
        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Location%20Carquefou.svg?width=600" alt="Localisation de Carquefou en Loire-Atlantique">
        <figcaption><b>Carquefou dans la Loire-Atlantique.</b> Nord-est immédiat de Nantes, entre l'Erdre et la Loire. — Wikimedia Commons, <i>Location Carquefou.svg</i></figcaption>
      </figure>
      <figure>
        <img src="https://commons.wikimedia.org/wiki/Special:FilePath/Blason%20ville%20fr%20Carquefou%20(Loire-Atlantique).svg?width=520" alt="Blason de Carquefou">
        <figcaption><b>Armes de Carquefou.</b> Le chef d'hermine rappelle l'appartenance bretonne de la paroisse, aux marches de l'Anjou. — Wikimedia Commons, <i>Blason ville fr Carquefou (Loire-Atlantique).svg</i></figcaption>
      </figure>
    </div>

    <div class="box">
      <h4>Contexte — Ce qu'est un laboureur</h4>
      <p>Le mot ne désigne pas un ouvrier agricole mais le sommet de la paysannerie : celui qui possède un attelage et une charrue, et qui exploite une métairie en fermage ou en métayage. Au-dessous viennent le <em>journalier</em>, payé à la journée, et le <em>domestique</em>, logé et nourri chez le maître. La branche Bonnet oscille entre ces trois états, et la trajectoire est plutôt descendante : laboureurs sous l'Ancien Régime, « laboureur, journalier » pour Pierre Marie Bonnet (1784-1835), simples cultivateurs au XIX<sup>e</sup>, puis maçon et ouvrier d'usine au XX<sup>e</sup>.</p>
      <p>Le terme <em>métayer</em>, porté par Gilles Beccavin (1728-1793), signale un contrat de partage des fruits avec le propriétaire — souvent la moitié de la récolte. À Carquefou, ces propriétaires sont les seigneurs de Maubreuil, de la Seilleraye, de l'Épinay.</p>
    </div>
  </div>
</section>

<!-- ═══════════════════════ LA LIGNE AGNATIQUE ═══════════════════════ -->
<section class="spread">
  <aside class="marg">
    <b>Lecture</b>
    Colonne centrale : la ligne Bonnet de père en fils. À droite, les destins qui s'en écartent — et l'année où ils s'en écartent.
    <span class="cote">Les traits rouges marquent une mort violente ou hors du pays.</span>
  </aside>
  <div class="col">
    <p class="eyebrow">Le fil</p>
    <h2>Neuf Bonnet, de père en fils</h2>

    <p class="lede">La filiation agnatique est continue et documentée de 1698 à aujourd'hui. Elle ne quitte Carquefou qu'une fois — pour la naissance de Julien à Nantes en 1733 — et n'y revient jamais moins.</p>

