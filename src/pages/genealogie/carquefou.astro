          <style>
            .sp{ stroke:#1B1F24; stroke-width:1.6; fill:none; }
            .br{ stroke:#8A2D28; stroke-width:.9; fill:none; }
            .brg{ stroke:#47664F; stroke-width:.9; fill:none; }
            .nm{ font-family:Newsreader,Georgia,serif; font-size:11px; fill:#1B1F24; }
