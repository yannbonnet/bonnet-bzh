            .so{ font-family:'IBM Plex Mono',monospace; font-size:7px; fill:#47664F; letter-spacing:.1em; }
            .ev{ font-family:Newsreader,Georgia,serif; font-size:9.5px; font-style:italic; fill:#8A2D28; }
            .evg{ font-family:Newsreader,Georgia,serif; font-size:9.5px; font-style:italic; fill:#47664F; }
          </style>
        </defs>

        <!-- spine -->
        <line class="sp" x1="150" y1="26" x2="150" y2="474"/>

        <!-- generations -->
        <g>
          <circle cx="150" cy="30"  r="3.4" fill="#1B1F24"/>
          <text class="so" x="140" y="26" text-anchor="end">256</text>
          <text class="nm" x="140" y="36" text-anchor="end">Jean Bonnet</text>
          <text class="yr" x="140" y="47" text-anchor="end">1698-1750 · laboureur</text>

          <circle cx="150" cy="85"  r="3.4" fill="#1B1F24"/>
          <text class="so" x="140" y="81" text-anchor="end">128</text>
          <text class="nm" x="140" y="91" text-anchor="end">Julien Bonnet</text>
          <text class="yr" x="140" y="102" text-anchor="end">1733-1774 · né à Nantes</text>

          <circle cx="150" cy="140" r="3.4" fill="#1B1F24"/>
          <text class="so" x="140" y="136" text-anchor="end">64</text>
          <text class="nm" x="140" y="146" text-anchor="end">Pierre Louis Thomas</text>
          <text class="yr" x="140" y="157" text-anchor="end">1757-1825 · laboureur</text>

          <circle cx="150" cy="195" r="3.4" fill="#1B1F24"/>
          <text class="so" x="140" y="191" text-anchor="end">32</text>
