---
import BaseLayout from '../layouts/BaseLayout.astro';

// Page hors collection ressources (§ brief) : pas un commun, pas de filtre,
// pas de flux RSS. Traduite intégralement en anglais (/en/genealogy/, §
// traduction anglaise de la page généalogique). Ancienne page d'accueil de
// genea.bonnet.bzh, qui redirige désormais ici en 301 (redirection à poser
// côté hébergement, hors de ce dépôt : genea.bonnet.bzh vit dans son propre
// dossier OVH, cf. CLAUDE.md §9).
const DESCRIPTION = "Enquête généalogique sur 426 ancêtres du pays d'Ancenis, de 1527 à nos jours, et sur le lien de parenté avec le naturaliste John James Audubon.";
---

<BaseLayout
  lang="fr"
  title="De la terre et de la forge aux oiseaux d'Amérique"
  description={DESCRIPTION}
  urlAutreLangue="/en/genealogy/"
>


<div class="hero">
  <div class="wrap">
    <div class="eyebrow">Enquête généalogique · août 2026</div>
    <h1>De la terre<br>et de la forge<br>aux <em>oiseaux d'Amérique</em></h1>
    <p class="sous">Quatre cent vingt-six ancêtres d'une même famille du pays d'Ancenis,
    reconstitués de 1527 à nos jours. Presque tous laboureurs, presque tous nés entre
    l'Erdre et la Loire. Et, sur une branche latérale, une fille de laboureur des Touches
    qui embarqua au début des années 1780 pour Saint-Domingue et dont le fils allait
    devenir le plus célèbre
    peintre d'oiseaux du monde.</p>
    <div class="chiffres">
      <div class="chiffre"><b>426</b><span>ancêtres directs</span></div>
      <div class="chiffre"><b>16</b><span>générations</span></div>
      <div class="chiffre"><b>11</b><span>communes principales</span></div>
      <div class="chiffre"><b>1527</b><span>ancêtre le plus ancien</span></div>
    </div>
  </div>
</div>
<div class="wide">
<section>
  <div class="num-sec">I · Le pays</div>
  <h2>Un mouchoir de poche</h2>
  <p class="chapo">Sur les 426 ancêtres, l'écrasante majorité naît dans une poignée de
  paroisses du nord de la Loire-Inférieure, entre l'Erdre et la Loire. Mésanger et
  Les Touches à elles seules en fournissent quatre-vingt-treize.</p>
  <div class="viz"><svg viewBox="0 0 940 560" role="img" aria-label="Carte des communes d'origine">
<circle cx="591.5" cy="238.9" r="248.7" class="ray"/>
<text x="591.5" y="8.2" class="ray-t" text-anchor="middle">rayon de 25 km</text>
