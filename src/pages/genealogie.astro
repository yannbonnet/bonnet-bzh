<text x="576.8" y="108.0" class="lb2">4</text>
<circle cx="653.2" cy="202.8" r="10.2" class="pt"/>
<text x="669.4" y="201.8" class="lb">Pouillé-les-Côteaux</text>
<text x="669.4" y="214.8" class="lb2">4</text>
<circle cx="358.5" cy="460.6" r="4" class="pt-ref"/>
<text x="367.5" y="464.6" class="lb-ref">Nantes</text>
<circle cx="639.9" cy="296.8" r="4" class="pt-ref"/>
<text x="648.9" y="300.8" class="lb-ref">Ancenis</text>
<circle cx="231.2" cy="464.0" r="5" class="pt-aud"/>
