<text x="658.5" y="176" class="fr-an" text-anchor="middle">1916</text>
<line x1="351.5" y1="150" x2="351.5" y2="110" class="fr-tige"/>
<circle cx="351.5" cy="150" r="6" class="fr-p"/>
<text x="351.5" y="76.0" class="fr-n" text-anchor="middle">Henri Bonnet</text>
<text x="351.5" y="92.0" class="fr-t" text-anchor="middle">29 ans · 6 juin 1915</text>
<text x="351.5" y="108.0" class="fr-t2" text-anchor="middle">Quennevières, Oise</text>
