<text x="456.2" y="271.2" class="lb2">12</text>
<circle cx="708.8" cy="248.4" r="13.6" class="pt"/>
<text x="728.5" y="247.4" class="lb">Saint-Herblon</text>
<text x="728.5" y="260.4" class="lb2">11</text>
