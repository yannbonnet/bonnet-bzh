---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListeRessources from '../../components/ListeRessources.astro';
import { getCollection } from 'astro:content';

const ressources = (
  await getCollection('ressources', (entry) => entry.id.startsWith('fr/'))
).sort((a, b) => b.data.annee - a.data.annee);
---

<BaseLayout lang="fr" title="Ressources" description="Bibliothèque de ressources sur les politiques publiques du numérique.">
  <h1 class="titre-page">Bibliothèque</h1>
  <ListeRessources lang="fr" entries={ressources} />
</BaseLayout>
