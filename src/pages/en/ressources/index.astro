---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListeRessources from '../../../components/ListeRessources.astro';
import { getCollection } from 'astro:content';

const ressources = (
  await getCollection('ressources', (entry) => entry.id.startsWith('en/'))
).sort((a, b) => b.data.annee - a.data.annee);
---

<BaseLayout lang="en" title="Resources" description="A library of resources on digital policy.">
  <h1 class="titre-page">Library</h1>
  <ListeRessources lang="en" entries={ressources} />
</BaseLayout>
