---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Bandeau from '../../../../components/Bandeau.astro';
import ListeRessources from '../../../../components/ListeRessources.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../../i18n/utils';
import { labelTheme } from '../../../../i18n/labels';

export async function getStaticPaths() {
  const entries = (
    await getCollection('ressources', (entry) => entry.id.startsWith('en/'))
  ).sort((a, b) => b.data.annee - a.data.annee);

  const themes = new Set(entries.flatMap((e) => e.data.themes));

  return Array.from(themes).map((theme) => ({
    params: { theme },
    props: { entries },
  }));
}

const { theme } = Astro.params;
const { entries } = Astro.props;
const t = useTranslations('en');
const titreTheme = labelTheme(theme as Parameters<typeof labelTheme>[0], 'en');
---

<BaseLayout lang="en" title={`${t('ressources.titre')} — ${titreTheme}`}>
  <Bandeau>
    <h1>{t('ressources.titre')}</h1>
  </Bandeau>
  <div class="corps-clair">
    <ListeRessources lang="en" entries={entries} themeActif={theme} />
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }
</style>
