---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Traduction intégrale de /genealogie, relue et approuvée section par
// section. Mêmes règles hors collection ressources que la version FR : pas de
// flux RSS, pas de filtre, pas de page de thème.
const DESCRIPTION = "A genealogical investigation into 426 ancestors from the pays d'Ancenis, traced from 1527 to the present day, and their kinship with the naturalist John James Audubon.";
---

<BaseLayout
  lang="en"
  title="From the Land and the Forge to the Birds of America"
  description={DESCRIPTION}
  urlAutreLangue="/genealogie/"
>

<div class="hero">
  <div class="wrap">
    <div class="eyebrow">A genealogical investigation · August 2026</div>
    <h1>From the land<br>and the forge<br>to the <em>birds of America</em></h1>
    <p class="sous">Four hundred and twenty-six ancestors from a single family in the
    <em>pays d'Ancenis</em> (the area around the town of Ancenis), traced from 1527 to
    the present day. Almost all of them were <em>laboureurs</em> (well-off tenant
    farmers who owned their own plough team — the top of the village social
    hierarchy), almost all born between the Erdre and Loire rivers. And, on a side
    branch, a laboureur's daughter from Les Touches who sailed for Saint-Domingue in
    the early 1780s, and whose son would become the world's most famous painter of
    birds.</p>
    <div class="chiffres">
      <div class="chiffre"><b>426</b><span>direct ancestors</span></div>
      <div class="chiffre"><b>16</b><span>generations</span></div>
      <div class="chiffre"><b>11</b><span>main communes</span></div>
      <div class="chiffre"><b>1527</b><span>earliest ancestor</span></div>
    </div>
  </div>
</div>
<div class="wide">
<section>
  <div class="num-sec">I · The land</div>
  <h2>A handkerchief of land</h2>
  <p class="chapo">Of the 426 ancestors, the overwhelming majority were born in a
  handful of <em>paroisses</em> (parishes — the basic civil and religious
  administrative unit before the Revolution) in the north of <em>Loire-Inférieure</em>
  (the department's name before its 1957 renaming to Loire-Atlantique), between the
  Erdre and Loire rivers. Mésanger and Les Touches alone account for ninety-three of
  them.</p>
