---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Bandeau from '../../../components/Bandeau.astro';
import ListeRessources from '../../../components/ListeRessources.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';

const DESCRIPTION = 'A library of knowledge commons on digital public policy.';

const ressources = (
  await getCollection('ressources', (entry) => entry.id.startsWith('en/'))
).sort((a, b) => b.data.annee - a.data.annee);

const t = useTranslations('en');

const annees = ressources.map((r) => r.data.annee);
const periode = annees.length > 0 ? `${Math.min(...annees)}–${Math.max(...annees)}` : '';
const institutions = new Set(ressources.map((r) => r.data.cadre));
---

<BaseLayout
  lang="en"
  title="Commons"
  description={DESCRIPTION}
  urlAutreLangue="/communs/"
  noindex={ressources.length === 0}
>
  <Bandeau>
    <p class="surtitre">{t('ressources.tousLesThemes')}</p>
    <h1>Commons</h1>
    <p class="chapeau">{DESCRIPTION}</p>
    {ressources.length > 0 && (
      <dl class="chiffres">
        <div class="chiffre">
          <dd>{ressources.length}</dd>
          <dt>{t('stats.communs')}</dt>
        </div>
        <div class="chiffre">
          <dd>{periode}</dd>
          <dt>{t('stats.periode')}</dt>
        </div>
        <div class="chiffre">
          <dd>{institutions.size}</dd>
          <dt>{t('stats.institutions')}</dt>
        </div>
      </dl>
    )}
  </Bandeau>
  <div class="corps-clair">
    <ListeRessources lang="en" entries={ressources} />
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }
</style>
