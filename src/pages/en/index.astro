---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bandeau from '../../components/Bandeau.astro';
import EntreeListe from '../../components/EntreeListe.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import { SELECTION_ACCUEIL } from '../../data/selection-accueil';

const ressources = await getCollection('ressources', (entry) => entry.id.startsWith('en/'));
const parGroupe = new Map(ressources.map((entry) => [entry.data.groupe, entry]));

const recentes = SELECTION_ACCUEIL.map((groupe) => {
  const entree = parGroupe.get(groupe);
  if (!entree) {
    throw new Error(`SELECTION_ACCUEIL: no EN entry for groupe "${groupe}".`);
  }
  return entree;
});

const t = useTranslations('en');
---

<BaseLayout
  lang="en"
  title="Home"
  titreExact="bonnet.bzh — knowledge commons on digital public policy"
  description="A commented archive of reports and notes on digital policy, AI governance and cybersecurity."
  urlAutreLangue="/"
>
  <Bandeau>
    <h1>Reports, and what became of them</h1>
    <p class="chapeau">
      This site brings together knowledge commons — reports, formal opinions, courses and
      notes — I have contributed to since 2013. Each comes with a critical review: what it
      set out to do, what it achieved, and what has aged badly.
    </p>
    <p class="chapeau">Yann Bonnet</p>
  </Bandeau>

  <div class="corps-clair">
    <section aria-labelledby="commons-title">
      <h2 id="commons-title">{t('accueil.communsTitre')}</h2>
      <ul class="liste-ressources">
        {recentes.map((entry) => <EntreeListe lang="en" entry={entry} />)}
      </ul>
      <p><a href="/en/commons/">{t('ressources.voirTout')} →</a></p>
    </section>

    <p class="orientation-genea">
      This site also holds a genealogical investigation,
      <em>From Soil and Forge to the Birds of America</em> — 426 ancestors from the
      Ancenis area, traced from 1527 to the present day.
      <a href="/en/genealogy/">Read it →</a>
    </p>
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }

  .liste-ressources {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .orientation-genea {
    margin-block-start: var(--espace-5);
    padding-block-start: var(--espace-3);
    border-block-start: 1px solid var(--papier-3);
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    color: var(--ardoise-3);
  }
</style>
