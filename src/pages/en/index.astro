---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bandeau from '../../components/Bandeau.astro';
import EntreeListe from '../../components/EntreeListe.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';

const NOMBRE_RECENTES = 5;

const ressources = (
  await getCollection('ressources', (entry) => entry.id.startsWith('en/'))
).sort((a, b) => b.data.annee - a.data.annee);

const recentes = ressources.slice(0, NOMBRE_RECENTES);
const t = useTranslations('en');
---

<BaseLayout
  lang="en"
  title="Home"
  titreExact="bonnet.bzh — knowledge commons on digital public policy"
  description="A commented archive of reports and notes on digital policy, AI governance and cybersecurity."
  urlAutreLangue="/"
>
  <Bandeau>
    <p class="surtitre">{t('accueil.surtitre')}</p>
    <h1>Yann Bonnet</h1>
    <p class="chapeau">
      I work on public policy for digital technology, innovation and deep tech.
    </p>
    <p class="chapeau">
      This site brings together knowledge commons — reports, formal opinions, courses and
      notes — I have contributed to since 2013, each with a critical review: what it set
      out to do, what it achieved, and what has aged badly.
    </p>
  </Bandeau>

  <div class="corps-clair">
    <section aria-labelledby="commons-title">
      <h2 id="commons-title">{t('accueil.communsTitre')}</h2>
      <ul class="liste-ressources">
        {recentes.map((entry) => <EntreeListe lang="en" entry={entry} />)}
      </ul>
      <p><a href="/en/commons/">{t('ressources.voirTout')} →</a></p>
    </section>

    <p class="orientation-genea">
      <a href="/en/genealogy/">{t('accueil.genea')}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }

  .liste-ressources {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .orientation-genea {
    margin-block-start: var(--espace-5);
    padding-block-start: var(--espace-3);
    border-block-start: 1px solid var(--papier-3);
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    color: var(--ardoise-3);
  }
</style>
