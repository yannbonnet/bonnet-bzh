---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';

// Pas de jobTitle : choix délibéré, la page ne nomme aucun employeur pour ne
// pas se périmer (§6, CLAUDE.md) — le déclarer en données structurées
// contredirait ce choix.
const jsonLdPersonne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://bonnet.bzh/a-propos/#personne',
  name: 'Yann Bonnet',
  mainEntityOfPage: 'https://bonnet.bzh/a-propos/',
  description: "Je travaille sur les politiques publiques du numérique, de l’innovation et de la deeptech.",
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'ISEP' },
  sameAs: [
    'https://fr.linkedin.com/in/yannbonnet',
    'https://fr.wikipedia.org/wiki/Yann_Bonnet',
    'https://www.vie-publique.fr/auteur/3505-yann-bonnet',
    'https://shs.cairn.info/publications-de-yann-bonnet--659973',
  ],
};
---

<BaseLayout lang="fr" title="Yann Bonnet" description="Parcours de Yann Bonnet." urlAutreLangue="/en/a-propos/">
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPersonne)} is:inline />
  </Fragment>
  <Bandeau>
    <p class="surtitre">Parcours</p>
    <h1>Yann Bonnet</h1>
  </Bandeau>
  <div class="corps-clair">
    <p>
      Je travaille sur les politiques publiques du numérique, de l’innovation et de la
      deeptech.
    </p>
    <p>
      Cofondateur du Campus Cyber, j'en ai été directeur général délégué de 2021 à 2025.
      Auparavant directeur de cabinet de Guillaume Poupard à l'Agence nationale de la
      sécurité des systèmes d'information (2018-2021), et secrétaire général du Conseil
      national du numérique (2015-2018), où j'étais entré comme rapporteur général en 2013.
    </p>
    <p>
      J'ai été co-pilote de la mission sur l'intelligence artificielle confiée à Cédric
      Villani par le Premier ministre en 2017, dont le rapport a défini la stratégie
      nationale française en la matière. Membre du groupe d'experts de haut niveau sur l'IA
      de la Commission européenne de 2018 à 2020, j'ai contribué aux travaux qui ont préparé
      le règlement européen sur l'IA.
    </p>
    <p>
      Ingénieur diplômé de l'ISEP. Né en 1981 à Nantes.
    </p>
    <p><a href="https://fr.linkedin.com/in/yannbonnet">Profil LinkedIn</a></p>
    <p>
      En marge de ces travaux, je conduis depuis plusieurs années une enquête généalogique :
      <a href="/genealogie/"><em>De la terre et de la forge aux oiseaux d'Amérique</em></a>.
    </p>
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }
</style>
