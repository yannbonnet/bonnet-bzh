---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import EntreeListe from '../components/EntreeListe.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

const NOMBRE_RECENTES = 5;

const ressources = (
  await getCollection('ressources', (entry) => entry.id.startsWith('fr/'))
).sort((a, b) => b.data.annee - a.data.annee);

const recentes = ressources.slice(0, NOMBRE_RECENTES);
const t = useTranslations('fr');
---

<BaseLayout
  lang="fr"
  title="Accueil"
  description="Bibliothèque d'archives commentées sur les politiques publiques du numérique, la gouvernance de l'IA et la cybersécurité."
  urlAutreLangue="/en/"
>
  <Bandeau>
    <p class="surtitre">{t('accueil.surtitre')}</p>
    <h1>Yann Bonnet</h1>
    <p class="chapeau">
      Je travaille sur les politiques publiques du numérique, la gouvernance de l'IA, la
      cybersécurité, l'innovation et la deeptech.
    </p>
    <p class="chapeau">
      Ce site rassemble les rapports, avis et notes auxquels j'ai contribué depuis 2013,
      chacun accompagné d'une relecture critique, ce qu'ils visaient, ce qu'ils ont
      produit, et ce qui a mal vieilli.
    </p>
  </Bandeau>

  <div class="corps-clair">
    <section aria-labelledby="bibliotheque-titre">
      <h2 id="bibliotheque-titre">Ressources</h2>
      <ul class="liste-ressources">
        {recentes.map((entry) => <EntreeListe lang="fr" entry={entry} />)}
      </ul>
      <p><a href="/communs/">{t('ressources.voirTout')} →</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }

  .liste-ressources {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
