---
import BaseLayout from '../layouts/BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import EntreeListe from '../components/EntreeListe.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { SELECTION_ACCUEIL } from '../data/selection-accueil';

const ressources = await getCollection('ressources', (entry) => entry.id.startsWith('fr/'));
const parGroupe = new Map(ressources.map((entry) => [entry.data.groupe, entry]));

const recentes = SELECTION_ACCUEIL.map((groupe) => {
  const entree = parGroupe.get(groupe);
  if (!entree) {
    throw new Error(`SELECTION_ACCUEIL : aucune fiche FR pour le groupe "${groupe}".`);
  }
  return entree;
});

const t = useTranslations('fr');
---

<BaseLayout
  lang="fr"
  title="Accueil"
  titreExact="bonnet.bzh — communs de la connaissance sur les politiques publiques du numérique"
  description="Bibliothèque d'archives commentées sur les politiques publiques du numérique, la gouvernance de l'IA et la cybersécurité."
  urlAutreLangue="/en/"
>
  <Bandeau>
    <h1>bonnet.bzh</h1>
    <p class="chapeau">
      Ce site personnel rassemble des communs de la connaissance (rapports, avis, cours et
      notes) auxquels j'ai contribué depuis 2013, chacun accompagné d'une relecture
      critique, ce qu'ils visaient, ce qu'ils ont produit, et ce qui a mal vieilli.
    </p>
    <p class="chapeau">
      Il porte aussi une enquête généalogique,
      <a href="/genealogie/"><em>De la terre et de la forge aux oiseaux d'Amérique</em></a> :
      426 ancêtres du pays d'Ancenis, de 1527 à nos jours.
    </p>
    <p class="chapeau">Yann Bonnet.</p>
  </Bandeau>

  <div class="corps-clair">
    <section aria-labelledby="communs-titre">
      <h2 id="communs-titre">{t('accueil.communsTitre')}</h2>
      <ul class="liste-ressources">
        {recentes.map((entry) => <EntreeListe lang="fr" entry={entry} />)}
      </ul>
      <p><a href="/communs/">{t('ressources.voirTout')} →</a></p>
    </section>
  </div>
</BaseLayout>

<style>
  .corps-clair {
    padding-block-start: var(--espace-4);
  }

  .liste-ressources {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
