---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import MetaBloc from '../components/MetaBloc.astro';
import Sommaire from '../components/Sommaire.astro';
import { useTranslations, urlJumelleFiche, segmentCommuns } from '../i18n/utils';
import { labelType, labelTheme } from '../i18n/labels';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: 'fr' | 'en';
  entry: CollectionEntry<'ressources'>;
  headings: Heading[];
}

const { lang, entry, headings } = Astro.props;
const {
  titre,
  sousTitre,
  annee,
  dateExacte,
  type,
  cadre,
  themes,
  liensComplementaires,
  lienCanonique,
  licence,
  resume,
} = entry.data;

const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : '/en';
const urlAutreLangue = await urlJumelleFiche(entry);
// Brouillon non relu (§ traduction anglaise) : la notice porte encore son
// marqueur TODO de tête, on ne l'indexe pas tant qu'elle n'a pas été validée.
const brouillonNonRelu = entry.body?.includes('TODO') ?? false;

// Article = la notice (ce texte-ci) ; CreativeWork = le document qu'elle
// commente. Les deux dates ne se confondent pas : la notice peut dater de
// 2026 quand le document commenté date de 2013. Aucune date de rédaction de
// notice n'existe dans le schéma aujourd'hui — plutôt que d'en inventer une
// ou de recopier celle du document, datePublished est omis sur l'Article.
const personneId = 'https://bonnet.bzh/a-propos/#personne';
const jsonLdArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titre,
  description: resume,
  inLanguage: lang,
  author: { '@type': 'Person', '@id': personneId, name: 'Yann Bonnet' },
  ...(licence ? { license: { '@type': 'CreativeWork', name: licence } } : {}),
  about: {
    '@type': 'CreativeWork',
    name: titre,
    datePublished: dateExacte ?? String(annee),
    publisher: { '@type': 'Organization', name: cadre },
    ...(lienCanonique ? { url: lienCanonique } : {}),
  },
};

// Fragment de titre en --fougere-cl (§ correction palette) : le dernier mot,
// seul repère mécanique disponible en l'absence d'un balisage éditorial dans
// `titre` — pas de jugement sémantique sur quel mot « compte ».
const motsTitre = titre.trim().split(' ');
const dernierMot = motsTitre.pop() ?? '';
const debutTitre = motsTitre.join(' ');
---

<BaseLayout lang={lang} title={titre} description={resume} urlAutreLangue={urlAutreLangue} noindex={brouillonNonRelu}>
  <Fragment slot="jsonld">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} is:inline />
  </Fragment>
  <article>
    <Bandeau>
      <p class="surtitre">{labelType(type, lang)} · {annee}</p>
      <h1>{debutTitre}{debutTitre ? ' ' : ''}<span class="fragment">{dernierMot}</span></h1>
      {sousTitre && <p class="chapeau">{sousTitre}</p>}
      <MetaBloc lang={lang} data={entry.data} />
    </Bandeau>

    <div class="corps-clair">
      <ul class="themes">
        {themes.map((theme) => (
          <li><a href={`${prefix}/${segmentCommuns(lang)}/theme/${theme}/`}>{labelTheme(theme, lang)}</a></li>
        ))}
      </ul>

      {liensComplementaires.length > 0 && (
        <div class="liens-complementaires">
          <p class="liens-complementaires-titre">{t('meta.liensComplementaires')}</p>
          <ul>
            {liensComplementaires.map((lien) => (
              <li><a href={lien.url}>{lien.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      <Sommaire lang={lang} headings={headings} />

      <p class="resume">{resume}</p>

      <div class="notice">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  /* Rupture nette vers le registre clair (§ correction palette) : un espace de
     respiration après le bandeau, rien de plus — pas de fondu. */
  .corps-clair {
    padding-block-start: var(--espace-4);
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    list-style: none;
    padding: 0;
    margin-block-end: var(--espace-2);
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
  }

  .liens-complementaires {
    margin-block: var(--espace-3);
  }

  .liens-complementaires-titre {
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    color: var(--fer);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
    margin-block-end: var(--espace-1);
  }

  .resume {
    font-weight: var(--graisse-demi);
  }
</style>
