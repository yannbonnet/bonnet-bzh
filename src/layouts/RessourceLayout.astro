---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Bandeau from '../components/Bandeau.astro';
import MetaBloc from '../components/MetaBloc.astro';
import Sommaire from '../components/Sommaire.astro';
import { useTranslations } from '../i18n/utils';
import { labelType, labelTheme } from '../i18n/labels';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: 'fr' | 'en';
  entry: CollectionEntry<'ressources'>;
  headings: Heading[];
}

const { lang, entry, headings } = Astro.props;
const {
  titre,
  sousTitre,
  annee,
  type,
  themes,
  lienCanonique,
  lienArchive,
  copieLocale,
  liensComplementaires,
  resume,
} = entry.data;

const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : '/en';
---

<BaseLayout lang={lang} title={titre} description={resume}>
  <article>
    <Bandeau>
      <p class="surtitre">{labelType(type, lang)} · {annee}</p>
      <h1>{titre}</h1>
      {sousTitre && <p class="chapeau">{sousTitre}</p>}
      <MetaBloc lang={lang} data={entry.data} />
    </Bandeau>

    <div class="corps-clair">
      <ul class="themes">
        {themes.map((theme) => (
          <li><a href={`${prefix}/ressources/theme/${theme}`}>{labelTheme(theme, lang)}</a></li>
        ))}
      </ul>

      {liensComplementaires.length > 0 && (
        <div class="liens-complementaires">
          <p class="liens-complementaires-titre">{t('meta.liensComplementaires')}</p>
          <ul>
            {liensComplementaires.map((lien) => (
              <li><a href={lien.url}>{lien.label}</a></li>
            ))}
          </ul>
        </div>
      )}

      <Sommaire lang={lang} headings={headings} />

      <p class="resume">{resume}</p>

      <div class="notice">
        <slot />
      </div>

      <footer class="liens">
        {lienCanonique && <p><a href={lienCanonique}>{t('meta.lienCanonique')}</a></p>}
        {lienArchive && <p><a href={lienArchive}>{t('meta.lienArchive')}</a></p>}
        {copieLocale && <p><a href={copieLocale}>{t('meta.copieLocale')}</a></p>}
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .surtitre {
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    color: var(--papier-3);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    margin-block-end: var(--espace-1);
  }

  .chapeau {
    font-family: var(--police-corps);
    font-style: italic;
    font-weight: 300;
    font-size: var(--taille-h2);
    color: var(--fougere-cl);
    margin-block: 0 var(--espace-2);
  }

  /* Rupture nette vers le registre clair (§ correction palette) : un espace de
     respiration après le bandeau, rien de plus — pas de fondu. */
  .corps-clair {
    padding-block-start: var(--espace-4);
  }

  .themes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    list-style: none;
    padding: 0;
    margin-block-end: var(--espace-2);
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
  }

  .liens-complementaires {
    margin-block: var(--espace-3);
  }

  .liens-complementaires-titre {
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    color: var(--fer);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
    margin-block-end: var(--espace-1);
  }

  .resume {
    font-weight: var(--graisse-demi);
  }

  .liens {
    margin-block-start: var(--espace-4);
    padding-block-start: var(--espace-3);
    border-block-start: 1px solid var(--papier-3);
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
  }
</style>
