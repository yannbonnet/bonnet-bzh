---
import '../styles/polices.css';
import '../styles/tokens.css';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'fr' | 'en';
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'fr' ? '' : '/en';

const DESCRIPTION_PAR_DEFAUT = lang === 'fr'
  ? "Bibliothèque d'archives commentées sur les politiques publiques du numérique, la gouvernance de l'IA et la cybersécurité."
  : 'A commented archive of reports and notes on digital policy, AI governance and cybersecurity.';

const titreComplet = `${title} — bonnet.bzh`;
const descriptionOg = description ?? DESCRIPTION_PAR_DEFAUT;
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlOgImage = new URL('/og.png', Astro.site);
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={descriptionOg} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="bonnet.bzh — Ressources" href="/rss.xml" />

    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={descriptionOg} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={urlOgImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="bonnet.bzh" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={descriptionOg} />
    <meta name="twitter:image" content={urlOgImage} />
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">{t('nav.eviter')}</a>

    <header>
      <nav aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        <a href={`${prefix}/`}>bonnet.bzh</a>
        <ul>
          <li><a href={`${prefix}/`}>{t('nav.accueil')}</a></li>
          <li><a href={`${prefix}/ressources/`}>{t('nav.ressources')}</a></li>
          <li><a href={`${prefix}/a-propos/`}>{t('nav.apropos')}</a></li>
          <li><a href="https://genea.bonnet.bzh">{t('nav.genea')}</a></li>
        </ul>
      </nav>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer>
      <p>{t('footer.licence')}</p>
      <p><a href="/mentions-legales/">{t('footer.mentions')}</a></p>
    </footer>
  </body>
</html>
