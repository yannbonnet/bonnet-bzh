---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { labelType, labelRole, labelRoleContribution } from '../i18n/labels';

interface Props {
  lang: 'fr' | 'en';
  data: CollectionEntry<'ressources'>['data'];
}

const { lang, data } = Astro.props;
const t = useTranslations(lang);
const {
  annee,
  dateExacte,
  type,
  cadre,
  volume,
  role,
  coAuteurs,
  contributions,
  lienCanonique,
  copieLocale,
  lienArchive,
  licence,
  accesRestreint,
} = data;

const SEUIL_COAUTEURS = 5;
const coAuteursVisibles = coAuteurs.slice(0, SEUIL_COAUTEURS);
const coAuteursRepliés = coAuteurs.slice(SEUIL_COAUTEURS);
const etAutres = t('meta.etAutres').replace('{n}', String(coAuteursRepliés.length));

const contributionsAffichees = contributions.map((c) => ({
  ...c,
  visibles: c.personnes.slice(0, SEUIL_COAUTEURS),
  repliees: c.personnes.slice(SEUIL_COAUTEURS),
}));
---

<div class="meta-bloc">
  <dl>
    <div class="meta-champ">
      <dt>{t('meta.annee')}</dt>
      <dd>{dateExacte ?? annee}</dd>
    </div>
    <div class="meta-champ">
      <dt>{t('meta.type')}</dt>
      <dd>{labelType(type, lang)}</dd>
    </div>
    <div class="meta-champ">
      <dt>{t('meta.cadre')}</dt>
      <dd>{cadre}</dd>
    </div>
    {volume && (
      <div class="meta-champ">
        <dt>{t('meta.volume')}</dt>
        <dd>{volume}</dd>
      </div>
    )}
    {role && (
      <div class="meta-champ">
        <dt>{t('meta.role')}</dt>
        <dd>{labelRole(role, lang)}</dd>
      </div>
    )}
    {coAuteurs.length > 0 && (
      <div class="meta-champ meta-champ-large">
        <dt>{t('meta.coAuteurs')}</dt>
        <dd>
          {coAuteursVisibles.join(', ')}
          {coAuteursRepliés.length > 0 && (
            <details>
              <summary>{etAutres}</summary>
              <ul>
                {coAuteursRepliés.map((nom) => <li>{nom}</li>)}
              </ul>
            </details>
          )}
        </dd>
      </div>
    )}
    {contributionsAffichees.map((c) => (
      <div class="meta-champ meta-champ-large">
        <dt>{labelRoleContribution(c.role, lang)}</dt>
        <dd>
          {c.visibles.join(', ')}
          {c.repliees.length > 0 && (
            <details>
              <summary>{t('meta.etAutres').replace('{n}', String(c.repliees.length))}</summary>
              <ul>
                {c.repliees.map((nom) => <li>{nom}</li>)}
              </ul>
            </details>
          )}
        </dd>
      </div>
    ))}
    {lienCanonique && (
      <div class="meta-champ">
        <dd><a href={lienCanonique}>{t('meta.lienCanonique')}</a></dd>
      </div>
    )}
    {copieLocale && (
      <div class="meta-champ meta-champ-large">
        <dd class="lien-local"><a href={copieLocale}>{t('meta.copieLocale')}</a></dd>
      </div>
    )}
    {lienArchive && (
      <div class="meta-champ">
        <dd><a href={lienArchive}>{t('meta.lienArchive')}</a></dd>
      </div>
    )}
    {licence && (
      <div class="meta-champ">
        <dt>{t('meta.licence')}</dt>
        <dd>{licence}</dd>
      </div>
    )}
    {accesRestreint && (
      <div class="meta-champ">
        <dt>{t('meta.accesRestreint')}</dt>
        <dd>{t('meta.accesRestreint')}</dd>
      </div>
    )}
  </dl>
</div>

<style>
  .meta-bloc {
    /* Vit désormais dans le bandeau sombre (Bandeau.astro) : un seul filet en
       tête suffit à le séparer du chapeau, la rupture nette vers le clair qui
       suit s'occupe de le refermer visuellement. */
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    border-block-start: 1px solid var(--ardoise-4);
    padding-block-start: var(--espace-2);
    margin-block-start: var(--espace-3);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--espace-4);
    row-gap: var(--espace-1);
    margin: 0;
  }

  @media (min-width: 640px) {
    dl {
      grid-template-columns: 1fr 1fr;
    }

    .meta-champ-large {
      grid-column: 1 / -1;
    }
  }

  .meta-champ {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    line-height: 1.5;
  }

  dt {
    color: var(--papier-3);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
  }

  dd {
    margin: 0;
    color: var(--papier);
  }

  /* Liens de document : --encre (couleur de lien par défaut du site) est
     illisible sur --ardoise, et --fougere (survol) n'y passe pas non plus
     (2,38:1, cf. tokens.css) — on reste en --papier avec un soulignement
     permanent plutôt qu'un changement de couleur au survol. */
  .meta-bloc a {
    color: var(--papier);
    text-decoration: underline;
  }

  .meta-bloc a:hover {
    text-decoration: none;
  }

  /* Copie locale : le lien que la plupart des lecteurs suivront, mis en
     évidence par la taille plutôt que par la graisse — seule la graisse 400
     de Plex Mono est chargée (CLAUDE.md §9), une 500 serait simulée par le
     navigateur. */
  .lien-local a {
    font-size: var(--taille-base);
  }

  details {
    display: inline;
  }

  summary {
    display: inline;
    cursor: pointer;
    color: var(--papier-3);
  }

  details ul {
    margin: var(--espace-1) 0 0;
    padding-inline-start: 1.2em;
  }
</style>
