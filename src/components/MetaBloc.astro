---
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import { labelType, labelRole } from '../i18n/labels';

interface Props {
  lang: 'fr' | 'en';
  data: CollectionEntry<'ressources'>['data'];
}

const { lang, data } = Astro.props;
const t = useTranslations(lang);
const { annee, dateExacte, type, cadre, role, coAuteurs, licence, accesRestreint } = data;

const SEUIL_COAUTEURS = 5;
const coAuteursVisibles = coAuteurs.slice(0, SEUIL_COAUTEURS);
const coAuteursRepliés = coAuteurs.slice(SEUIL_COAUTEURS);
const etAutres = t('meta.etAutres').replace('{n}', String(coAuteursRepliés.length));
---

<div class="meta-bloc">
  <dl>
    <div class="meta-champ">
      <dt>{t('meta.annee')}</dt>
      <dd>{dateExacte ?? annee}</dd>
    </div>
    <div class="meta-champ">
      <dt>{t('meta.type')}</dt>
      <dd>{labelType(type, lang)}</dd>
    </div>
    <div class="meta-champ">
      <dt>{t('meta.cadre')}</dt>
      <dd>{cadre}</dd>
    </div>
    {role && (
      <div class="meta-champ">
        <dt>{t('meta.role')}</dt>
        <dd>{labelRole(role, lang)}</dd>
      </div>
    )}
    {coAuteurs.length > 0 && (
      <div class="meta-champ meta-champ-large">
        <dt>{t('meta.coAuteurs')}</dt>
        <dd>
          {coAuteursVisibles.join(', ')}
          {coAuteursRepliés.length > 0 && (
            <details>
              <summary>{etAutres}</summary>
              <ul>
                {coAuteursRepliés.map((nom) => <li>{nom}</li>)}
              </ul>
            </details>
          )}
        </dd>
      </div>
    )}
    {licence && (
      <div class="meta-champ">
        <dt>{t('meta.licence')}</dt>
        <dd>{licence}</dd>
      </div>
    )}
    {accesRestreint && (
      <div class="meta-champ">
        <dt>{t('meta.accesRestreint')}</dt>
        <dd>{t('meta.accesRestreint')}</dd>
      </div>
    )}
  </dl>
</div>

<style>
  .meta-bloc {
    /* Vit désormais dans le bandeau sombre (Bandeau.astro) : un seul filet en
       tête suffit à le séparer du chapeau, la rupture nette vers le clair qui
       suit s'occupe de le refermer visuellement. */
    font-family: var(--police-mono);
    font-size: var(--taille-petite);
    border-block-start: 1px solid var(--ardoise-4);
    padding-block-start: var(--espace-2);
    margin-block-start: var(--espace-3);
  }

  dl {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--espace-4);
    row-gap: var(--espace-1);
    margin: 0;
  }

  @media (min-width: 640px) {
    dl {
      grid-template-columns: 1fr 1fr;
    }

    .meta-champ-large {
      grid-column: 1 / -1;
    }
  }

  .meta-champ {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    line-height: 1.5;
  }

  dt {
    color: var(--papier-3);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
  }

  dd {
    margin: 0;
    color: var(--papier);
  }

  details {
    display: inline;
  }

  summary {
    display: inline;
    cursor: pointer;
    color: var(--papier-3);
  }

  details ul {
    margin: var(--espace-1) 0 0;
    padding-inline-start: 1.2em;
  }
</style>
