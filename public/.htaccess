# Redirection du www vers l'apex
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.bonnet\.bzh$ [NC]
RewriteRule ^(.*)$ https://bonnet.bzh/$1 [R=301,L]

# Redirection du domaine technique OVH vers l'apex : il sert aujourd'hui le
# même contenu et constitue du contenu dupliqué (CLAUDE.md §9).
RewriteCond %{HTTP_HOST} ^bonnetbzvo\.cluster011\.ovh\.net$ [NC]
RewriteRule ^(.*)$ https://bonnet.bzh/$1 [R=301,L]

# Forçage HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Renommage de la section « Ressources » en « Communs » (site en ligne depuis
# quelques heures, aucune indexation Search Console à préserver). Placées avant
# la barre oblique finale pour rediriger directement vers la forme canonique,
# sans dépendre de l'existence du dossier ; le groupe capturé est optionnel
# (« (/.*)? ») pour couvrir aussi bien l'URL avec slash final que sans.
RewriteRule ^en/ressources(/.*)?$ /en/commons$1 [R=301,L]
RewriteRule ^ressources(/.*)?$ /communs$1 [R=301,L]

# Barre oblique finale, écrite explicitement avant que mod_dir n'intervienne :
# UseCanonicalName et UseCanonicalPhysicalPort ne sont pas autorisées en
# .htaccess (configuration serveur uniquement, inaccessible sur mutualisé
# OVH), et la redirection implicite de mod_dir y ajoute le port physique du
# listener (:443) dans le Location. URL absolue sans port, donc écrite en dur.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://bonnet.bzh/$1/ [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # 'unsafe-inline' sur style-src uniquement : Astro compile les styles de
  # composants en balises <style> intégrées à chaque page (pas de contenu
  # tiers, pas de script) ; script-src reste strict, sans exception, puisque
  # le script des filtres est un fichier externe (public/scripts/filtres.js).
  # frame-src : seule exception à default-src 'self', pour les embeds vidéo
  # tiers (rapport-villani-2018 : youtube-nocookie.com et mediatheque.univ-
  # paris1.fr ; ambition-numerique-2015 : dailymotion.com, dont l'iframe
  # officielle redirige vers geo.dailymotion.com ; cnnum-neutralite-plateformes-2014 :
  # youtube-nocookie.com) — sans ces domaines, le navigateur bloque
  # silencieusement l'iframe malgré une src correcte.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src https://www.youtube-nocookie.com https://mediatheque.univ-paris1.fr https://www.dailymotion.com https://geo.dailymotion.com; object-src 'none'; base-uri 'self'"
</IfModule>
